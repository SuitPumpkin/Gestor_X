<UserControl x:Class="GestorX.Componentes.TextoConBorde"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:local="clr-namespace:GestorX.Componentes"
             mc:Ignorable="d">
    <Grid HorizontalAlignment="{Binding PosiciónHorizontal, RelativeSource= {RelativeSource AncestorType=UserControl}}" VerticalAlignment="Top" Margin="0,-10,0,0">
        <hc:OutlineText Text="{Binding Texto, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                       StrokeThickness="{Binding Grosor, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                       Fill="{Binding ColorDeRelleno, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                       FontSize="{Binding Tamaño, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                       FontFamily="{Binding Fuente, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Stroke="{Binding ColorDeBorde, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       FontWeight="Bold"/>
        <hc:OutlineText Text="{Binding Texto, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                       StrokeThickness="{Binding Grosor, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                       Fill="{Binding ColorDeRelleno, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                       FontSize="{Binding Tamaño, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                       FontFamily="{Binding Fuente, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       Stroke="Transparent"
                       FontWeight="Bold"/>
    </Grid>
</UserControl>
