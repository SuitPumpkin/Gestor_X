<UserControl x:Class="GestorX.Componentes.Botón1"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             xmlns:local="clr-namespace:GestorX.Componentes"
             mc:Ignorable="d">
    <Border x:Name="MainBorder" Style="{StaticResource ButtonStyle}">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <fa:IconBlock x:Name="IconBlock" 
                         Icon="{Binding Icono, RelativeSource={RelativeSource AncestorType=local:Botón1}}"
                         Foreground="#262626" 
                         FontSize="16" 
                         VerticalAlignment="Center" 
                         IconFont="Solid" 
                         Margin="5,0,5,0"/>
            <TextBlock x:Name="TextBlock" 
                      Text="{Binding Texto, RelativeSource={RelativeSource AncestorType=local:Botón1}}"
                      FontSize="12" 
                      Foreground="#262626" 
                      VerticalAlignment="Center" 
                      FontWeight="Black" 
                      Margin="0,0,5,0"/>
        </StackPanel>
    </Border>
</UserControl> 