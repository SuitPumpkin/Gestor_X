<UserControl x:Class="GestorX.Pestañas.Inventario"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             xmlns:hc="https://handyorg.github.io/handycontrol" 
             xmlns:local="clr-namespace:GestorX.Pestañas"
             xmlns:componentes="clr-namespace:GestorX.Componentes"
             mc:Ignorable="d" 
             d:DesignHeight="440" d:DesignWidth="630" Loaded="UserControl_Loaded">
    <Grid>
        <!--Titulo-->
        <StackPanel VerticalAlignment="Top" Orientation="Horizontal" Height="50" Margin="10,5,5,5">
            <fa:IconBlock Icon="WindowMinimize" Foreground="Black" IconFont="Solid" VerticalAlignment="Center" Margin="0,0,-10,10" FontSize="30" RenderTransformOrigin="0.5,0.5">
                <fa:IconBlock.RenderTransform>
                    <TransformGroup>
                        <RotateTransform Angle="90"/>
                    </TransformGroup>
                </fa:IconBlock.RenderTransform>
            </fa:IconBlock>
            <componentes:TextoConBorde Texto="Inventario" Tamaño="30" ColorDeBorde="Black" ColorDeRelleno="White" Grosor="5" VerticalAlignment="Center"/>
            <fa:IconBlock Icon="Boxes" Foreground="Black" IconFont="Solid" VerticalAlignment="Center" FontSize="20" Margin="10,0,0,5"/>
        </StackPanel>
        <!-- Busqueda-->
        <hc:SearchBar x:Name="BarraDeBusqueda" Cursor="IBeam" Foreground="#262626" BorderThickness="0" FontSize="20" TextAlignment="Right" hc:InfoElement.Placeholder="Buscar" VerticalAlignment="Top" Height="30" TextChanged="BusquedaUpdate" Margin="220,10,100,0"/>
        <!-- Controles-->
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" Orientation="Vertical">
            <StackPanel.Resources>
                <Style x:Key="Botón" TargetType="Border">
                    <Setter Property="Height" Value="30"/>
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="BorderBrush" Value="White"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="CornerRadius" Value="4"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Style.Triggers>
                        <EventTrigger RoutedEvent="MouseEnter">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation  Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="#FF0078D7" Duration="0:0:0.2" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                        <EventTrigger RoutedEvent="MouseLeave">
                            <BeginStoryboard>
                                <Storyboard>
                                    <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="White" Duration="0:0:0.2" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Resources>
            <Border Style="{StaticResource Botón}" MouseLeftButtonDown="Agregar" >
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <fa:IconBlock Icon="PlusCircle" Foreground="#262626" FontSize="16" VerticalAlignment="Center" IconFont="Solid" Margin="5,0,5,0"/>
                    <TextBlock FontSize="12" Foreground="#262626" Text="Agregar" VerticalAlignment="Center" FontWeight="Black" Margin="0,0,5,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
        <!-- Lista -->
        <Grid Margin="10,30,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DataGrid x:Name="Lista" 
                     MinWidth="610"
                     AutoGenerateColumns="False"
                     CanUserAddRows="False"
                     CanUserDeleteRows="False"
                     CanUserReorderColumns="False"
                     CanUserResizeColumns="True"
                     CanUserResizeRows="False"
                     CanUserSortColumns="True"
                     GridLinesVisibility="All"
                     HeadersVisibility="Column"
                     IsReadOnly="True"
                     SelectionMode="Single"
                     SelectionUnit="FullRow"
                     VerticalAlignment="Top" 
                     BorderThickness="0" 
                     HorizontalAlignment="Center"
                     ItemsSource="{Binding Items}"
                     MouseDoubleClick="Editar"
                     RowHeight="60"
                     Margin="0,29,0,0">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#F5F5F5"/>
                        <Setter Property="BorderBrush" Value="#E0E0E0"/>
                        <Setter Property="BorderThickness" Value="0,0,1,1"/>
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Foreground" Value="#262626"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridColumnHeader">
                                    <Grid>
                                        <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                        </Border>
                                    </Grid>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Imagen"
                                                    Width="100" 
                                                    MinWidth="65"
                                                    SortMemberPath="ID">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding Item.Imagen}" 
                                               Stretch="Uniform">
                                    <Image.ToolTip>
                                        <Image Source="{Binding Item.Imagen}" 
                                                       Width="400" 
                                                       Stretch="UniformToFill"/>
                                    </Image.ToolTip>
                                </Image>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Nombre" Width="*" MinWidth="150" SortMemberPath="Nombre">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Item.Nombre}" 
                                           FontWeight="Bold"
                                           TextWrapping="Wrap"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Cantidad" Width="100" MinWidth="90" SortMemberPath="Cantidad">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="x" 
                                               FontWeight="Bold" 
                                               Margin="0,0,5,0"/>
                                    <TextBlock Text="{Binding Item.Cantidad}" 
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Item.Unidad}" 
                                               Margin="5,0,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Precio" Width="70" MinWidth="60" SortMemberPath="Precio">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="$" 
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Item.Precio}" 
                                               FontWeight="Bold"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTemplateColumn Header="Vendedor" Width="150" MinWidth="120" SortMemberPath="Vendedor">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding NombreProveedor}" 
                                           FontWeight="Bold"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <hc:Pagination x:Name="Paginador"
                          Grid.Row="1"
                          HorizontalAlignment="Right"
                          Margin="0,10,0,0"
                          PageIndex="1"
                          DataCountPerPage="8"
                          IsJumpEnabled="False"
                          PageUpdated="Paginador_PageUpdated"/>
        </Grid>
    </Grid>
</UserControl>
