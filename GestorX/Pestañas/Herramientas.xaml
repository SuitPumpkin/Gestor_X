<UserControl x:Class="GestorX.Pestañas.Herramientas"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:fa="http://schemas.awesome.incremented/wpf/xaml/fontawesome.sharp"
             xmlns:hc="https://handyorg.github.io/handycontrol" 
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             xmlns:local="clr-namespace:GestorX.Pestañas"
             xmlns:componentes="clr-namespace:GestorX.Componentes"
             mc:Ignorable="d" 
             d:DesignHeight="440" d:DesignWidth="630">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Orientation="Vertical">
                <!--Titulo-->
                <StackPanel Orientation="Horizontal" Height="50" Margin="10,5,5,5">
                    <fa:IconBlock Icon="WindowMinimize" Foreground="Black" IconFont="Solid" VerticalAlignment="Center" Margin="0,0,-10,10" FontSize="30" RenderTransformOrigin="0.5,0.5">
                        <fa:IconBlock.RenderTransform>
                            <TransformGroup>
                                <RotateTransform Angle="90"/>
                            </TransformGroup>
                        </fa:IconBlock.RenderTransform>
                    </fa:IconBlock>
                    <componentes:TextoConBorde Texto="Herramientas" Tamaño="30" ColorDeBorde="Black" ColorDeRelleno="White" Grosor="5" VerticalAlignment="Center"/>
                    <fa:IconBlock Icon="Wrench" Foreground="Black" IconFont="Solid" VerticalAlignment="Center" FontSize="20" Margin="10,0,0,5"/>
                </StackPanel>
                <!--Pared de Herramientas-->
                <Border Height="200" Background="White" BorderBrush="Black" BorderThickness="3" CornerRadius="10" Margin="10,0,10,0">
                    <Grid>
                        <!--Coverview de todas las posibles maquetaciones-->
                        <componentes:TextoConBorde Texto="Mockups" ColorDeBorde="Black" ColorDeRelleno="White" Tamaño="18" Grosor="5" Margin="5,0,5,0"/>
                    </Grid>
                </Border>
                <Border Height="200" Background="White" BorderBrush="Black" BorderThickness="3" CornerRadius="10" Margin="10,20,10,0">
                    <Grid>
                        <!--Coverview de todos los calculos que podrian necesitarse-->
                        <componentes:TextoConBorde Texto="Calculos Financieros" ColorDeBorde="Black" ColorDeRelleno="White" Tamaño="18" Grosor="5" Margin="5,0,5,0" PosiciónHorizontal="Right"/>
                    </Grid>
                </Border>
                <Border Height="200" Background="White" BorderBrush="Black" BorderThickness="3" CornerRadius="10" Margin="10,20,10,0">
                    <Grid>
                        <!--Coverview de todas las medidas populares que se puedan requerir-->
                        <!--EJEMPLO: medida tarjetas, medida volantes, medida para camisa grande, medida para camisa chica, etc-->
                        <componentes:TextoConBorde Texto="Medidas" ColorDeBorde="Black" ColorDeRelleno="White" Tamaño="18" Grosor="5" Margin="5,0,5,0"/>
                    </Grid>
                </Border>
                <Border Height="200" Background="White" BorderBrush="Black" BorderThickness="3" CornerRadius="10" Margin="10,20,10,0">
                    <Grid>
                        <!--Coverview de todas las utilidades que se necesiten-->
                        <!--EJEMPLO: borrar fondos automaticamente, convertir formatos, etc-->
                        <componentes:TextoConBorde Texto="Utilidades" ColorDeBorde="Black" ColorDeRelleno="White" Tamaño="18" Grosor="5" Margin="5,0,5,0" PosiciónHorizontal="Right"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
